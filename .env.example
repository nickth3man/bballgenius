# Copy to .env and set paths for your machine (Bun loads .env on `bun run start`).
#
# Main database: games, box scores, career stats.
# If unset, defaults to data/nba.duckdb (or data/fixtures/nba.ci.duckdb in CI).
NBA_DUCKDB_PATH=data/nba.duckdb

# Optional: accolades from basketball-data (v_player_honors_full, winners only).
# Leave empty to load awards from the main database only.
NBA_HONORS_DUCKDB_PATH=

# LangSmith tracing (optional).
# Set both to enable automatic LangGraph trace logging.
LANGSMITH_TRACING=
LANGSMITH_API_KEY=

# Chatbot debug mode (optional).
# Set to true to log graph state transitions and SQL queries to console.
CHATBOT_DEBUG=

# Chatbot metrics directory (optional).
# Defaults to data/ if not set.
CHATBOT_METRICS_DIR=
