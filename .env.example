# ── Database ────────────────────────────────────────────────────────────────
# Main database: games, box scores, player stats.
# Defaults to data/nba.duckdb (or data/fixtures/nba.ci.duckdb in CI).
NBA_DUCKDB_PATH=data/nba.duckdb

# Optional: honors database (v_player_honors_full view).
# Leave empty to load awards from the main database only.
NBA_HONORS_DUCKDB_PATH=

# ── Chatbot ─────────────────────────────────────────────────────────────────
# OpenRouter API key (required).
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Model ID passed to OpenRouter (default: openai/gpt-oss-120b).
MODEL=openai/gpt-oss-120b

# Debug mode — logs graph state transitions and SQL queries to stderr.
CHATBOT_DEBUG=true

# Checkpoint persistence directory.
# If unset, uses MemorySaver (in-memory only, lost on restart).
CHATBOT_PERSIST_DIR=

# Metrics output directory (default: data/).
CHATBOT_METRICS_DIR=

# ── LangSmith Tracing (optional) ────────────────────────────────────────────
# Set both to enable LangGraph/LangChain trace logging.
LANGSMITH_TRACING=
LANGSMITH_API_KEY=

# ── BBR / Firecrawl (screenshots and crawling) ──────────────────────────────
FIRECRAWL_API_KEY=fc-xxx

# See scripts/takeBbrScreenshots.cjs for defaults.
# BBR_CRAWL_CONCURRENCY=2
# BBR_CRAWL_BUDGET=500
# BBR_SCRAPE_TIMEOUT_MS=120000
# BBR_SCRAPE_RATE_LIMIT_MS=1500
# BBR_SCRAPE_DELAY_MS=1500
# BBR_STATUS_INTERVAL_MS=15000
# BBR_DISCOVERY_COOLDOWN_MS=1500
# BBR_VERBOSE_PATHS=1
# BBR_USE_LEGACY_SEEDS=0
# BBR_PASS_D_MAX_SEEDS=40
# BBR_MAP_RUN_LOG=
# BBR_OBSERVE_CYCLE=
# BBR_SCOPE=

# ── Smoke / eval scripts ───────────────────────────────────────────────────
# DRY_RUN=1
# CHATBOT_SMOKE_SUITE=facts
# CHATBOT_SMOKE_LIMIT=10
# CHATBOT_SMOKE_TIMEOUT_MS=120000
# ITERATION_MAX=5
# PARALLEL_MODELS=true
# SOURCE_DB=data/nba.duckdb
# OUT_DB=data/fixtures/nba.ci.duckdb
