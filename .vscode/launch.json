{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "bun",
      "request": "launch",
      "name": "Debug Data Package Tests",
      "program": "${workspaceFolder}/node_modules/.bin/bun",
      "args": ["test", "packages/data/src", "--concurrency=1"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "type": "bun",
      "request": "launch",
      "name": "Debug Current Test File",
      "program": "${workspaceFolder}/node_modules/.bin/bun",
      "args": ["test", "${relativeFile}", "--concurrency=1"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
