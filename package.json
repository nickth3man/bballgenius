{
  "name": "bballgenius",
  "version": "1.0.0",
  "description": "BBallGenius Terminal Hub: Consolidated NBA Analytics Suite",
  "packageManager": "bun@1.3.6",
  "main": "src/hub/index.ts",
  "type": "module",
  "scripts": {
    "start": "bun run src/hub/index.ts",
    "hub:start": "bun run src/hub/index.ts",
    "chatbot:start": "bun run src/chatbot/index.ts",
    "test:chatbot": "bun test src/chatbot/__tests__ --concurrency=1",
    "chatbot:smoke": "bun run scripts/chatbot-smoke.ts",
    "chatbot:smoke:100": "CHATBOT_SMOKE_SUITE=100 bun run scripts/chatbot-smoke.ts",
    "test": "bun test src/hub/tests --concurrency=1",
    "test:unit": "bun test src/hub/tests/formatters.test.ts --concurrency=1",
    "test:regression": "bun test src/hub/tests/regression.test.ts src/hub/tests/mutation.test.ts src/hub/tests/visual_frame.test.ts src/hub/tests/app_shell.test.ts src/hub/tests/golden_snapshot.test.ts --concurrency=1",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:chatbot": "tsc --noEmit -p tsconfig.chatbot.json",
    "audit": "bun audit --audit-level=moderate",
    "lint": "biome ci src scripts --error-on-warnings",
    "lint:fix": "biome check --write src scripts",
    "format:check": "biome check --write src scripts && git diff --exit-code -- src scripts",
    "keyboard-map:sync": "bun run scripts/sync-keyboard-map.ts",
    "fixture:build": "bun run scripts/build-ci-fixture.ts",
    "ci:integration": "NBA_DUCKDB_PATH=data/fixtures/nba.ci.duckdb bun test src/hub/tests --concurrency=1",
    "ci": "bash scripts/ci-guards.sh && bun run lint && bun run format:check && bun run typecheck && bun run test:unit && bun run ci:integration && bun run audit",
    "bbr:map": "BBR_MAP_DELAY_SEC=0 BBR_MAP_PARALLEL=2 bash scripts/buildBbrUrlMap.sh",
    "bbr:map:players": "BBR_SCOPE=players BBR_MAP_DELAY_SEC=0 BBR_MAP_PARALLEL=2 bash scripts/buildBbrUrlMap.sh",
    "bbr:map:merge": "bun run scripts/mergeBbrUrlMap.ts",
    "bbr:crawl": "BBR_CRAWL_CONCURRENCY=2 bash scripts/bbrPreflightCrawl.sh && node scripts/takeBbrScreenshots.cjs",
    "bbr:crawl:players": "BBR_SCOPE=players BBR_CRAWL_CONCURRENCY=2 bash scripts/bbrPreflightCrawl.sh && node scripts/takeBbrScreenshots.cjs",
    "bbr:map-then-crawl": "bash scripts/bbrWaitMapThenCrawl.sh",
    "bbr:verify": "node scripts/verifyBbrScreenshots.cjs",
    "bbr:verify:map": "node scripts/verifyBbrScreenshots.cjs --map-only",
    "bbr:status": "node scripts/bbrObservability.cjs status",
    "bbr:watch": "node scripts/bbrObservability.cjs watch",
    "bbr:map:cancel": "node scripts/bbrObservability.cjs map-cancel",
    "bbr:observe": "bash scripts/bbrMapObserveCycle.sh",
    "bbr:scrape-depth-samples": "node scripts/scrapeDepthSamples.cjs",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.5.2-r.2",
    "@duckdb/node-bindings": "^1.5.2-r.2",
    "@langchain/core": "^1.1.47",
    "@langchain/langgraph": "^1.3.2",
    "@langchain/openai": "^1.4.6",
    "@opentui/core": "^0.2.14",
    "langchain": "^1.4.1",
    "openai": "^6.38.0",
    "playwright": "^1.60.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.1",
    "lefthook": "^2.1.8",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "typescript": "$typescript"
  }
}
