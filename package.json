{
  "name": "bballgenius",
  "version": "1.0.0",
  "description": "BBallGenius Terminal Hub: Consolidated NBA Analytics Suite",
  "packageManager": "bun@1.3.6",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "hub:start": "bun run src/index.ts",
    "test:chatbot": "bun test src/tabs/chatbot/__tests__ src/tabs/chatbot/eval/__tests__ --concurrency=1",
    "test:changed": "bun test --changed",
    "test:changed:watch": "bun test --changed --watch",
    "test:quick": "bun test --changed --bail",
    "snapshots:update": "UPDATE_SNAPSHOTS=1 NBA_DUCKDB_PATH=data/fixtures/nba.ci.duckdb bun test src/tests/golden_snapshot.test.ts src/tests/visual_frame.test.ts --concurrency=1",
    "chatbot:smoke": "bun run scripts/eval/chatbot-smoke.ts",
    "chatbot:matrix": "bun run src/tabs/chatbot/eval/matrixHarness.ts",
    "chatbot:iterate": "bun run scripts/eval/iterate_loop.ts",
    "chatbot:smoke:100": "CHATBOT_SMOKE_SUITE=100 bun run scripts/eval/chatbot-smoke.ts",
    "test": "bun test src/tests --concurrency=1",
    "test:unit": "bun test src/tests/formatters.test.ts --concurrency=1",
    "test:regression": "bun test src/tests/regression.test.ts src/tests/mutation.test.ts src/tests/visual_frame.test.ts src/tests/app_shell.test.ts src/tests/golden_snapshot.test.ts --concurrency=1",
    "test:coverage": "bun test src/tests src/tabs/chatbot/__tests__ --coverage --concurrency=1",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:chatbot": "tsc --noEmit -p tsconfig.json",
    "audit": "bun audit --audit-level=moderate",
    "lint": "biome ci src scripts/bbr scripts/ci scripts/eval scripts/dev --error-on-warnings",
    "lint:fix": "biome check --write src scripts/bbr scripts/ci scripts/eval scripts/dev",
    "format:check": "biome check --write src scripts/bbr scripts/ci scripts/eval scripts/dev && git diff --exit-code -- src scripts/bbr scripts/ci scripts/eval scripts/dev",
    "keyboard-map:sync": "bun run scripts/dev/sync-keyboard-map.ts",
    "fixture:build": "bun run scripts/ci/build-ci-fixture.ts",
    "dq": "bun run scripts/db/verify-dq.ts",
    "dq:gate": "bun run scripts/db/verify-dq.ts --gate=HIGH",
    "dq:accuracy": "bun run scripts/db/build-canonical-metric-registry.ts --apply && bun run scripts/db/build-canonical-merge.ts --apply && bun run scripts/db/classify-accuracy-discrepancies.ts",
    "dq:oracle": "bun run scripts/db/oracle-resolve-discrepancies.ts",
    "dq:full": "bun run dq:accuracy && bun run dq:gate",
    "dq:fixture": "NBA_DUCKDB_PATH=data/fixtures/nba.ci.duckdb bun run scripts/db/verify-dq-fixture.ts",
    "ci:integration": "NBA_DUCKDB_PATH=data/fixtures/nba.ci.duckdb bun test src/tests --concurrency=1",
    "ci": "bash scripts/ci/ci-guards.sh && bun run lint && bun run format:check && bun run typecheck && bun run test:unit && bun run ci:integration && bun run audit",
    "bbr:map": "BBR_MAP_DELAY_SEC=0 BBR_MAP_PARALLEL=2 bash scripts/bbr/buildBbrUrlMap.sh",
    "bbr:map:players": "BBR_SCOPE=players BBR_MAP_DELAY_SEC=0 BBR_MAP_PARALLEL=2 bash scripts/bbr/buildBbrUrlMap.sh",
    "bbr:map:merge": "bun run scripts/bbr/mergeBbrUrlMap.ts",
    "bbr:crawl": "BBR_CRAWL_CONCURRENCY=2 bash scripts/bbr/bbrPreflightCrawl.sh && node scripts/bbr/takeBbrScreenshots.cjs",
    "bbr:crawl:players": "BBR_SCOPE=players BBR_CRAWL_CONCURRENCY=2 bash scripts/bbr/bbrPreflightCrawl.sh && node scripts/bbr/takeBbrScreenshots.cjs",
    "bbr:map-then-crawl": "bash scripts/bbr/bbrWaitMapThenCrawl.sh",
    "bbr:verify": "node scripts/bbr/verifyBbrScreenshots.cjs",
    "bbr:verify:map": "node scripts/bbr/verifyBbrScreenshots.cjs --map-only",
    "bbr:status": "node scripts/bbr/bbrObservability.cjs status",
    "bbr:watch": "node scripts/bbr/bbrObservability.cjs watch",
    "bbr:map:cancel": "node scripts/bbr/bbrObservability.cjs map-cancel",
    "bbr:observe": "bash scripts/bbr/bbrMapObserveCycle.sh",
    "hub:capture-frames": "bun run scripts/dev/capture-frames.ts",
    "bbr:scrape-depth-samples": "node scripts/bbr/scrapeDepthSamples.cjs",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.5.2-r.2",
    "@duckdb/node-bindings": "^1.5.2-r.2",
    "@langchain/core": "^1.1.47",
    "@langchain/langgraph": "^1.3.2",
    "@langchain/openai": "^1.4.6",
    "@opentui/core": "^0.3.0",
    "langchain": "^1.4.1",
    "openai": "^6.38.0",
    "playwright": "^1.60.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.1",
    "cheerio": "^1.2.0",
    "lefthook": "^2.1.8",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "typescript": "$typescript"
  }
}
